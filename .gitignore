# Local environment / credentials
.env
*.env
.env.*

manifests/
scripts/

# Rejected snapshots. A failing snapshot test writes the text it actually
# produced beside the recorded one; `cargo insta review` then accepts it (which
# overwrites the .snap) or discards it. Either way the .new file is scratch, and
# committing one would check in an unreviewed result.
*.snap.new

# Eval harness output (regenerate with `cargo run -p constellation-eval`).
eval/results/

# The CI retrieval-quality fixture, rebuilt by the workflow on every run.
eval/fixture/

# The fixture survey's corpus: absolute paths to indexed repositories on one
# developer's disk. `cargo xtask fixtures survey` writes a template on first run.
fixtures.toml
